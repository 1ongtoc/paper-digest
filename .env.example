# 本地运行时复制为 .env 后自行加载；GitHub Actions 请创建同名 Secrets。
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-your-key
AI_MODEL=deepseek-v4-flash

# QQ 邮箱：smtp.qq.com；163 邮箱：smtp.163.com。端口均建议 465。
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-name@qq.com
SMTP_PASSWORD=邮箱生成的 SMTP 授权码，不是登录密码
EMAIL_FROM=your-name@qq.com
EMAIL_TO=your-name@qq.com
